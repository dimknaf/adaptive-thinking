# Copy to .env (at the repository root, next to this file) and fill in.
# adaptive_thinking/config.py reads every variable listed here, and this file
# lists every variable it reads (tests/test_config.py checks both).
# A commented-out line shows a knob at its code default; uncomment it to
# change it. docs/CONFIG.md has the full table, including the knobs the engine
# does not read at present and the ones that have been removed.
# .env is gitignored - the key never goes in a tracked file.
#
# Precedence: a variable already set in the process environment wins over this
# file. An EMPTY value, here or in the environment, falls back to the default
# in adaptive_thinking/config.py - not to anything written here.

# --- endpoint ---------------------------------------------------------------
# An OpenAI-compatible vLLM server. /v1/completions must accept a LIST of
# prompts (batching), top-k logprobs up to 20, and the `logprob_token_ids` /
# `return_tokens_as_token_ids` extension. /tokenize and /metrics are read from
# the server root, i.e. this URL without the trailing /v1.
OPENAI_BASE_URL=https://your-vllm-host/v1
# The model the recorded measurements were taken on. The chat format is
# hard-coded in adaptive_thinking/chatml.py as Qwen3 ChatML with <think>, so
# another model family needs changes there, not just here.
OPENAI_MODEL=QUASAR-QAT/Qwen3.8-27B-QUASAR-NVFP4
OPENAI_API_KEY=
# Some deployments reject unknown client User-Agents; set one here.
LLM_USER_AGENT=adaptive-thinking/0.1
LLM_TIMEOUT=300
# Transient failures (HTTP 429, 500, 502, 503, 504 and 524, connection errors
# and timeouts) are retried this many times, waiting LLM_RETRY_BACKOFF x
# attempt seconds. A stream is only retried before it has produced a token.
# LLM_RETRIES=2
# LLM_RETRY_BACKOFF=3.0

# --- tier 1: entropy, as a floor -------------------------------------------
# Entropy is NOT used as a gate. Measured on an earlier engine (scripts in
# experiments/archive/, historical), the gate probe's P(yes) was independent of
# entropy - high-entropy positions scored 0.407 against 0.484 for mid-entropy
# ones. Entropy only rules out positions where the top token holds nearly all
# the mass, because branching there produces identical strings. Re-measure on
# a different model.
ENTROPY_FLOOR=0.4
# Tokens that must pass after a block before another can open.
MIN_GAP_TOKENS=12
# No block may open before this many answer tokens. A block closing inside the
# opening sentence made the model restart the answer; every restart observed
# was in the opening sentence.
# WARMUP_TOKENS=28

# --- tier 2: the gate, batched over positions -------------------------------
# Stream this many tokens, then score the best candidate positions inside the
# window in ONE request. One round trip per window instead of one per token.
WINDOW_TOKENS=24
PROBE_CANDIDATES=6
# Reference threshold for the old binary Yes/No probe. That probe no longer
# decides anything; it is only logged alongside the gate (GATE_LOG_YESNO) and
# experiments/gate_audit.py compares against this number. 0.60 sits between
# the measured essay median (0.202) and the arithmetic median (0.622).
PROBE_THRESHOLD=0.60
# Criticality - the weighted mean of the gate axes, 0..1 - at or above which a
# block opens. SET FROM MEASUREMENT, over 20 probed positions (the code default
# is the uncalibrated 0.55):
#     >= 0.55 (code default)    fired 20/20  100%
#     >= 0.78                   fired 11/20   55%
#     >= 0.80                   fired  4/20   20%
#     >= 0.82                   fired  1/20    5%
# Read that as cost control, not judgement: the whole distribution is squeezed
# into 0.746-0.824 because the stakes and commitment axes are saturated, so
# this picks the top fifth by score rather than the positions that most
# deserve thought. The axes have to discriminate before the number can mean
# more than it does.
GATE_THRESHOLD=0.80
# Also ask the old Yes/No probe at every probed position and record its P(yes)
# on the window event, for calibration. One extra batched request per window
# that has a candidate position.
# GATE_LOG_YESNO=true
# false = open a block on entropy alone, ignoring the gate (ablation). In this
# mode a block's crit is NaN, which is not valid JSON for the browser UI.
PROBE_ENABLED=true

# --- the thinking block -----------------------------------------------------
# A tree of BEAM_WIDTH conversations. At each checkpoint ONE request advances
# every live beam by up to THINK_CHUNK tokens; each beam then proposes
# THINK_BRANCH_K alternatives for its last token, and the BEAM_WIDTH x
# THINK_BRANCH_K candidates are pruned straight back to at most BEAM_WIDTH. The
# width never grows. THINK_CHUNK sets how often the tree checkpoints; it is not
# a cap on thinking - a block ends when its beams close it.
BEAM_WIDTH=4
THINK_BRANCH_K=5
THINK_CHUNK=500
# Not read by the engine at present (experiments/tree_probe.py prints it).
CHOICE_SHORTLIST=8
# Not read by the engine at present: candidates are ranked on length-normalised
# logprob and the survivors are judged on the axes. 0 records the historical
# decision. Measured on the earlier per-token engine: a labelled single-token
# Choice, inspired by jevfire, cost 72 requests against 40, answered 18:12
# where logprob ranking answered 18:25, and flipped its winner on 4 of 8
# reversed-order probes.
CHOICE_EVERY=0
# Ask the Choice in both option orders and average. Only Engine._rank reads it,
# and only experiments/tree_probe.py calls that.
CHOICE_DEBIAS=true
# Survivors one beam's chunk may contribute to the next frontier. The k
# candidates from one chunk share all but their last token, so at temperature
# 0 two of them stay near-twins; pruning backfills past this cap only when the
# frontier cannot otherwise be filled.
# MAX_CHILDREN_PER_PARENT=1
# Diversity penalties, subtracted from a candidate's length-normalised logprob.
# COPY_PENALTY is charged when a candidate's last COPY_NGRAM characters already
# appear in the context: copying is almost free in logprob terms and was
# winning blocks. SIBLING_PENALTY is charged for a token an earlier sibling
# already took; as the code stands it never applies, because one beam's
# alternatives are always distinct tokens.
# COPY_PENALTY=0.60
# COPY_NGRAM=24
# SIBLING_PENALTY=0.35
# Bad conversations leave and a variation of a good branch takes their place.
# How far behind the block's best thought a live conversation may be before it
# stops counting as a possible challenger, on the raw 0..1 axis scale.
# PROVISIONAL: read off the standings of a single run (0.02-0.06 in a normal
# field, 0.18 for one clearly bad thought), and the churn was not observed to
# fire in any recorded run.
CHURN_MARGIN=0.12
# The margin of safety. A conversation behind the leader is REPLACED while the
# block is still finding better thoughts; only after this many checkpoints
# without a new best does a retirement close the slot instead.
CHURN_PATIENCE=2
# The judge standardises each axis within a group of candidates and clips it to
# this many units, so no single axis can decide a candidate on its own.
# AXIS_CLIP=2.0
# Stop waiting for a better thought once this many have finished, the best
# finished thought leads the next by STOP_MARGIN on the standardised score, and
# no live beam is still within CHURN_MARGIN of the leader.
# STOP_AFTER_FINISHED=3
# STOP_MARGIN=0.35
# A live beam grown this many times longer than the longest finished thought is
# dropped - but only if it is also out of contention on score.
# RAMBLE_RATIO=2.5

# --- the answer, and what a block leaves in it ------------------------------
# Alternatives read at each ANSWER position while streaming (feeds the entropy
# floor). Not the beam width.
BRANCH_K=5
# Leave the thinking block in the context the model reads, so it has to resume
# an answer it was interrupted mid-sentence. Off = the block leaves no trace
# and continuation is seamless by construction, which proves nothing.
KEEP_BLOCKS_INLINE=true
# What opens the monologue. Deliberately bare - no instruction on top.
# Measured: a bare "<think>" makes the model RESTART the answer; two words of
# seed make it reflect. This is a seed, not an instruction prompt.
INLINE_SEED=<think>Hmm, hold on.
# Characters of the answer so far that a block replays after its </think>, so
# the model finds the sentence already in flight. Without it the model started
# the same answer over four times in one turn.
# ANCHOR_CHARS=90
# Tokens after a block whose logprobs are compared against the response mean.
RESUME_WATCH_TOKENS=12

# --- the opening thought ----------------------------------------------------
# Think before answering, at the position Qwen's template reserves for it.
# The same tree runs unconditionally before the first answer token: it IS the
# model's own opening reasoning, searched instead of guessed. The gate's
# mid-answer blocks carry on after it. Off = the old cold start.
OPEN_THINK=true
# Bare on purpose, unlike INLINE_SEED. Those two extra words exist because
# mid-answer a lone "<think>" makes the model restart the sentence; at the top
# of the turn there is nothing to restart, so the seed is the template's own:
# <think> followed by a newline. Leave it unset. Unquoted, this file would store
# a literal backslash-n (or, written bare, drop the newline); if it must be set
# here, double quotes are required:
# OPEN_SEED="<think>\n"

# --- baselines --------------------------------------------------------------
# Token cap for the NATIVE arm of experiments/bench_hard.py only. The engine
# arm there is uncapped, so the two arms do not get the same limit.
# experiments/zebra/run.py does not use this: it gives the native arm the
# server's max_model_len.
# NATIVE_MAX_TOKENS=1600

# --- context management -----------------------------------------------------
# Eviction is by AGE - how many tokens have been generated since a block was
# written - not by transcript size. Nothing is summarised: the blocks are
# deleted, the prefix changes, and the next request re-prefills.
#
# The gap between the two matters. Eviction only TRIGGERS at EVICT_AGE_TOKENS,
# and then clears the whole band older than EVICT_KEEP_TOKENS in one pass. A
# single threshold would fire constantly and each firing throws away the KV
# cache from that point on.
EVICT_AGE_TOKENS=100000
EVICT_KEEP_TOKENS=20000

# --- server -----------------------------------------------------------------
# The demo server listens on 127.0.0.1 at this port (code default 8099).
PORT=8123
